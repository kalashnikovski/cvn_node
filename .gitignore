ledger_vault.json
evolved_vault.txt
network_health_summary.log
cvn_mainnet.db
backups/
*.txt
*.bak
*.db

# Node Hardware Profile Configs
miner_config.json

# Local Compiled Binaries
cvn_node.exe
cvn_node
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go Workspace & Dependency Artifacts
bin/
pkg/
obj/
.go/
vendor/

# Operating System Cache Files
