# ============================================================================
# COVENANT STANDARD (CVN) - LOCAL RUNTIME EXCLUSIONS
# ============================================================================

# Local Data Ledgers & Vault Storage
backups/
*.txt
# The site's security contact file is published.
!/site/.well-known/security.txt
*.bak
*.db

# Node Hardware Profile Configs
miner_config.json
# A private key locked with a password (never publish it)
wallet_key.json

# Local Compiled Binaries
cvn_node.exe
cvn_node
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go Workspace & Dependency Artifacts
bin/
pkg/
obj/
.go/
vendor/

# Operating System Cache Files
.DS_Store
Thumbs.db
# Peers this node has reached before (local, rebuilt automatically)
peers.json
peers.json.tmp

# Wallet screen build dependencies (restored with setup_wallet_deps.bat)
node_modules/
frontend/package.json.md5

# Development network files
peers_devnet.json
peers_devnet.json.tmp
peers_testnet.json
peers_testnet.json.tmp
genesis_anchor_*.txt

# Maintainer's own operations scripts and working folders (not part of the project)
/scripts/
/release_package/

# Source packs and reviewers' answers (made by audit/make_audit_pack.py)
/audit/out/

# The fast miner, downloaded separately; never part of this repository.
xmrig-cvn/

# Private test kit for testers (GPU vs CPU RandomX); never pushed.
/CVN_GPU_vs_CPU_Test.zip
