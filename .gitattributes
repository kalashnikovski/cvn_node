# Scripts for Linux servers must keep Unix line endings on every machine.
*.sh text eol=lf

# The built wallet screens are compiled into the program. They must be the
# same bytes on every machine, or nobody could rebuild the program and get
# the published one.
frontend/dist/** -text

# Windows batch files must keep Windows line endings on every machine and in
# every download: the command interpreter can lose its place in a batch file
# that has Unix line endings.
*.bat text eol=crlf
